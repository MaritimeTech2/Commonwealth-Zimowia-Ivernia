{
	"id":"czi_shimmer",
	"type":"STAT_MOD",
	#"aiType":"TEMPORAL_SHELL",
	"aiType":"CUSTOM",
    "aiScript":"data.scripts.shipsystems.ai.CZIShimmerAi",
	
	"statsScript":"data.scripts.shipsystems.ShimmerStats",
    "runScriptWhilePaused":true, # only for the player's ship
    "runScriptWhileIdle":true,  # this means unapply() never gets called
    "blockActionsWhileChargingDown":false,

	"canNotCauseOverload":true,

    "phaseHighlight":"_glow1",
    "phaseDiffuse":"_glow2",

    "effectColor1":[255,175,255,255],
    "effectColor2":[255,0,255,150],

	"soundFilterType":"LOWPASS",
	"soundFilterGain":0.75,
	"soundFilterGainHF":0.5,

	"fadeActivationSoundOnChargedown":true,
	"useSound":"system_temporalshell",
	"loopSound":"system_temporalshell_loop",
	"deactivateSound":"system_temporalshell_off",
	"outOfUsesSound":"system_phase_cloak_collision",
	
	"aiHints":{
		"activeSpeedIncrease":80,  # not right since it's ship-dependent, but hopefully close enough
		"burstMovementPotential":0,
		"averageSpeedMult":1.46,
	}
}




